{
  "entities": {
    "merchant": {
      "title": "Merchant",
      "description": "Merchant details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "businessName": { "type": "string" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "businessName", "currency"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer entity",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "nationalId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "name", "phone"]
    },
    "product": {
      "title": "Product",
      "description": "Product entity",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "out_of_stock"] },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "name", "price", "stock", "status"]
    },
    "contract": {
      "title": "Contract",
      "description": "Installment contract",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "customerId": { "type": "string" },
        "productId": { "type": "string" },
        "startDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "archived", "cancelled"] },
        "installments": { "type": "array", "items": { "$ref": "#/entities/installment" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "customerId", "productId", "startDate", "totalAmount", "remainingAmount", "status"]
    },
    "installment": {
      "title": "Installment",
      "description": "Installment payment within a contract",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "late"] }
      },
      "required": ["date", "amount", "paidAmount", "status"]
    },
    "payment": {
      "title": "Payment",
      "description": "A payment record",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "contractId": { "type": "string" },
        "installmentId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "contractId", "amount", "date"]
    },
    "notification": {
      "title": "Notification",
      "description": "Notification for merchant",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["merchantId", "title", "message", "type", "read", "date"]
    }
  },
  "firestore": {
    "merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/merchant" },
      "description": "Merchant profiles"
    },
    "merchants/{merchantId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/customer" },
      "description": "Customers for a merchant"
    },
    "merchants/{merchantId}/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Products for a merchant"
    },
    "merchants/{merchantId}/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/contract" },
      "description": "Contracts for a merchant"
    },
    "merchants/{merchantId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/payment" },
      "description": "Payments received by a merchant"
    },
    "merchants/{merchantId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/notification" },
      "description": "Notifications for a merchant"
    }
  }
}
